{
  "name": "PDF Signer",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  // Override the CMD so the container stays alive for development
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  // Mount the project root into /app so edits are live
  "workspaceFolder": "/app",
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind,consistency=cached",
  // Install deps after container starts (in case requirements.txt changed)
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  // Useful ports (add more if you expose a UI later)
  "forwardPorts": []
}
